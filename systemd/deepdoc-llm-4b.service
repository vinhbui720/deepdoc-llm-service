[Unit]
Description=DeepDoc Qwen3-4B LAN inference
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/prt-llm-bench
ExecStart=%h/prt-llm-bench/build/bin/llama-server -m %h/DeepDoc/models/Qwen3-4B-Q4_K_M.gguf --host <bl4000-lan-ip> --port 18443 -ngl 99 -c 128000 --rope-scaling yarn --rope-scale 3.125 --yarn-orig-ctx 32768 -np 1 --no-webui --api-key-file tls/api.key --ssl-key-file tls/srv.key --ssl-cert-file tls/srv.crt
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes

[Install]
WantedBy=default.target
